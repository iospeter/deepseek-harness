{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // scratch-plugin is intentionally outside the pnpm workspace, so
    // @deepseek-ai/cordis has no node_modules link here. Alias it to the
    // vendored build types for IDE type resolution only; runtime resolution
    // is provided by the cordis loader.
    "paths": {
      "@deepseek-ai/cordis": ["../vendor/cordis/lib/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
